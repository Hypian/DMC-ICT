{
  "database": {
    "connectionString": "",
    "host": "localhost",
    "port": 5432,
    "database": "dmc_claims_service",
    "user": "dmc_reader",
    "password": "",
    "ssl": false,
    "schemaPath": "./db/schema.sql"
  },
  "mis": {
    "readOnly": true,
    "strategy": "scheduled-view-sync",
    "sources": [
      { "name": "emr_fhir", "type": "fhir", "enabled": true },
      { "name": "legacy_rest", "type": "rest", "enabled": true }
    ]
  },
  "thirdParty": {
    "integrations": [
      { "name": "SHA", "type": "api", "enabled": false, "todo": "Source from DMC-approved contract and keep patient data on the LAN only." },
      { "name": "MMI", "type": "portal", "enabled": false, "todo": "Future portal integration; out of scope for v1." },
      { "name": "RSSB", "type": "portal", "enabled": false, "todo": "Future portal integration; out of scope for v1." }
    ]
  },
  "hmis": {
    "fhir": {
      "enabled": true,
      "baseUrl": "https://emr.dmc-hospital.org/fhir/R4",
      "authType": "Bearer",
      "timeoutMs": 5000
    },
    "rest": {
      "enabled": true,
      "baseUrl": "https://emr.dmc-hospital.org/api/v1",
      "authType": "Basic",
      "timeoutMs": 5000
    }
  },
  "insurance": {
    "sha": {
      "enabled": true,
      "endpoint": "https://api.sha.go.ke/v2/verify",
      "facilityCode": "DMC-HOSP-0042",
      "currency": "KES"
    },
    "smartEdi": {
      "enabled": true,
      "endpoint": "https://edi.smartapplicationsgroup.com/claims/v1",
      "facilityId": "DMC-091",
      "currency": "KES"
    }
  },
  "rules": {
    "currency": "KES",
    "preAuthRequiredProcedures": [
      "CT scan",
      "MRI",
      "Endoscopy",
      "Laparoscopy",
      "Dialysis",
      "ICU Admission"
    ],
    "highCostThreshold": 10000,
    "tariffs": {
      "Consultation - General": 3000,
      "Consultation - Specialist": 4000,
      "CT scan - abdomen": 12800,
      "MRI - Lumbar Spine": 28000,
      "Comprehensive Metabolic Panel": 8000,
      "Full Hemogram": 3200
    }
  }
}
